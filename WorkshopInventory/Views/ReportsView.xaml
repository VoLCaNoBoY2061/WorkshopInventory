<UserControl x:Class="WorkshopInventory.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Margin="8">

        <!-- ================= ВКЛАДКА 1: ОТЧЁТ ОБ ОСТАТКАХ ================= -->
        <TabItem Header="Отчёт об остатках">
            <DockPanel Margin="8">
                <!-- Кнопка экспорта -->
                <Button DockPanel.Dock="Top" 
                        Content="📥 Экспорт в Excel" 
                        Width="160" Height="30" 
                        Background="#217346" Foreground="White" FontWeight="Bold" 
                        HorizontalAlignment="Right" Margin="0,0,0,10"
                        Click="OnExportStockClick"/>

                <!-- Таблица -->
                <DataGrid x:Name="StockGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                        <DataGridTextColumn Header="Остаток (все склады)" Binding="{Binding Quantity}" Width="150"/>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                        <DataGridTextColumn Header="Мин. остаток" Binding="{Binding MinQuantity}" Width="100"/>
                        <DataGridCheckBoxColumn Header="Дефицит" Binding="{Binding IsBelowMinimum, Mode=OneWay}" IsReadOnly="True" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ================= ВКЛАДКА 2: ОСТАТКИ ПО СКЛАДАМ ================= -->
        <TabItem Header="Остатки по складам">
            <DockPanel Margin="8">
                <!-- Кнопка экспорта -->
                <Button DockPanel.Dock="Top" 
                        Content="📥 Экспорт в Excel" 
                        Width="160" Height="30" 
                        Background="#217346" Foreground="White" FontWeight="Bold" 
                        HorizontalAlignment="Right" Margin="0,0,0,10"
                        Click="OnExportStockByLocationClick"/>

                <!-- Таблица -->
                <DataGrid x:Name="StockByLocationGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                        <DataGridTextColumn Header="Склад" Binding="{Binding Location}" Width="200"/>
                        <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- ================= ВКЛАДКА 3: ДВИЖЕНИЕ МАТЕРИАЛОВ ================= -->
        <TabItem Header="Движение материалов">
            <DockPanel Margin="8">
                <!-- Кнопка экспорта -->
                <Button DockPanel.Dock="Top" 
                        Content="📥 Экспорт в Excel" 
                        Width="160" Height="30" 
                        Background="#217346" Foreground="White" FontWeight="Bold" 
                        HorizontalAlignment="Right" Margin="0,0,0,10"
                        Click="OnExportMovementClick"/>

                <!-- Таблица -->
                <DataGrid x:Name="MovementGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="140"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                        <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="220"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

    </TabControl>
</UserControl>