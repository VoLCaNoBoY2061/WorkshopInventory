<UserControl x:Class="WorkshopInventory.Views.MaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="15">

        <!-- ================= ФИЛЬТР ПО СКЛАДУ ================= -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="🏭 Фильтр по складу:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
            <ComboBox x:Name="LocationCombo" Width="200" VerticalAlignment="Center" SelectionChanged="OnLocationChanged"/>
            <Button Content="🔄 Обновить" Width="100" Height="26" Margin="10,0,0,0" VerticalAlignment="Center" Click="OnRefreshClick"/>
        </StackPanel>

        <!-- ================= ПАНЕЛЬ ДОБАВЛЕНИЯ МАТЕРИАЛА ================= -->
        <StackPanel x:Name="AddPanel" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,20">
            <TextBlock Text="➕ Добавление нового материала" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#2C3E50"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="150"/>
                    <!-- Название -->
                    <ColumnDefinition Width="60"/>
                    <!-- Ед. изм. -->
                    <ColumnDefinition Width="1.5*" MinWidth="100"/>
                    <!-- Категория -->
                    <ColumnDefinition Width="85"/>
                    <!-- Мин. остаток -->
                    <ColumnDefinition Width="85"/>
                    <!-- Нач. остаток -->
                    <ColumnDefinition Width="1.5*" MinWidth="120"/>
                    <!-- Склад -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Кнопка -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Строка подписей -->
                    <RowDefinition Height="Auto"/>
                    <!-- Строка полей ввода -->
                </Grid.RowDefinitions>

                <!-- Строка 0: Подписи -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Название материала" FontSize="12" Foreground="DimGray" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Ед." FontSize="12" Foreground="DimGray" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Категория" FontSize="12" Foreground="DimGray" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Мин. остаток" FontSize="12" Foreground="DimGray" Margin="0,0,4,4" ToolTip="Порог, при котором материал считается в дефиците (по всем складам)"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="Нач. остаток" FontSize="12" Foreground="DimGray" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="0" Grid.Column="5" Text="Склад для нач. остатка" FontSize="12" Foreground="DimGray" Margin="0,0,4,4"/>

                <!-- Строка 1: Поля ввода -->
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" Margin="0,0,4,0" ToolTip="Введите полное название материала"/>
                <TextBox x:Name="UnitBox" Grid.Row="1" Grid.Column="1" Text="шт" Margin="0,0,4,0"/>
                <TextBox x:Name="CategoryBox" Grid.Row="1" Grid.Column="2" Margin="0,0,4,0"/>
                <TextBox x:Name="MinQtyBox" Grid.Row="1" Grid.Column="3" Text="0" Margin="0,0,4,0" PreviewTextInput="NumberValidationTextBox"/>
                <TextBox x:Name="QtyBox" Grid.Row="1" Grid.Column="4" Text="0" Margin="0,0,4,0" PreviewTextInput="NumberValidationTextBox"/>
                <TextBox x:Name="LocationBox" Grid.Row="1" Grid.Column="5" Text="Основной склад" Margin="0,0,8,0"/>

                <Button Grid.Row="1" Grid.Column="6" Content="Добавить" Width="110" Height="26" FontWeight="Bold" Background="#D4EDDA" Click="OnAddMaterial"/>
            </Grid>
        </StackPanel>

        <!-- ================= ТАБЛИЦА МАТЕРИАЛОВ ================= -->
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Материал" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="120"/>
                <DataGridTextColumn Header="Ед." Binding="{Binding Unit}" Width="60"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="90"/>
                <DataGridTextColumn Header="Мин. остаток" Binding="{Binding MinQuantity}" Width="100"/>
                <DataGridTextColumn Header="Склад" Binding="{Binding Location}" Width="150"/>
                <DataGridCheckBoxColumn Header="Дефицит" Binding="{Binding IsBelowMinimum, Mode=OneWay}" IsReadOnly="True" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>