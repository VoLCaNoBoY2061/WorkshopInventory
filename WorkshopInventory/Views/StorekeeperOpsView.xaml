<UserControl x:Class="WorkshopInventory.Views.StorekeeperOpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">

            <!-- ================= УЧЁТ ПОСТУПЛЕНИЙ ================= -->
            <TextBlock Text="📥 Учёт поступлений (Оприходование)" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#2C3E50"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <!-- Материал -->
                    <ColumnDefinition Width="80" />
                    <!-- Кол-во -->
                    <ColumnDefinition Width="150"/>
                    <!-- Поставщик -->
                    <ColumnDefinition Width="*"/>
                    <!-- Склад (растягивается) -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Кнопка -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Строка подписей -->
                    <RowDefinition Height="Auto"/>
                    <!-- Строка полей -->
                </Grid.RowDefinitions>

                <!-- Подписи -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Материал" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Кол-во" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Поставщик" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Склад назначения (можно ввести новый)" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>

                <!-- Поля ввода -->
                <ComboBox x:Name="ReceiptMaterial" Grid.Row="1" Grid.Column="0" DisplayMemberPath="Name" Margin="0,0,5,0"/>
                <TextBox x:Name="ReceiptQty" Grid.Row="1" Grid.Column="1" Margin="0,0,5,0" ToolTip="Введите число"/>
                <TextBox x:Name="ReceiptSupplier" Grid.Row="1" Grid.Column="2" Margin="0,0,5,0"/>
                <ComboBox x:Name="ReceiptLocation" Grid.Row="1" Grid.Column="3" IsEditable="True" Margin="0,0,10,0"/>
                <Button Grid.Row="1" Grid.Column="4" Content="Оприходовать" Width="110" Height="26" FontWeight="Bold" Background="#D4EDDA" Click="OnReceipt"/>
            </Grid>

            <Separator Margin="0,0,0,20"/>

            <!-- ================= СПИСАНИЕ ================= -->
            <TextBlock Text="📤 Списание" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#2C3E50"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Материал" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Кол-во" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Причина списания" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Склад (откуда списываем)" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>

                <ComboBox x:Name="WriteOffMaterial" Grid.Row="1" Grid.Column="0" DisplayMemberPath="Name" Margin="0,0,5,0"/>
                <TextBox x:Name="WriteOffQty" Grid.Row="1" Grid.Column="1" Margin="0,0,5,0"/>
                <TextBox x:Name="WriteOffReason" Grid.Row="1" Grid.Column="2" Margin="0,0,5,0"/>
                <ComboBox x:Name="WriteOffLocation" Grid.Row="1" Grid.Column="3" IsEditable="True" Margin="0,0,10,0"/>
                <Button Grid.Row="1" Grid.Column="4" Content="Списать" Width="110" Height="26" FontWeight="Bold" Background="#F8D7DA" Click="OnWriteOff"/>
            </Grid>

            <Separator Margin="0,0,0,20"/>

            <!-- ================= ПЕРЕМЕЩЕНИЕ ================= -->
            <TextBlock Text="🔄 Перемещение между складами" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#2C3E50"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Материал" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Кол-во" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Откуда (текущий склад)" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Куда (можно ввести новый)" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>

                <ComboBox x:Name="MovementMaterial" Grid.Row="1" Grid.Column="0" DisplayMemberPath="Name" Margin="0,0,5,0"/>
                <TextBox x:Name="MovementQty" Grid.Row="1" Grid.Column="1" Margin="0,0,5,0"/>
                <ComboBox x:Name="MovementFrom" Grid.Row="1" Grid.Column="2" Margin="0,0,5,0"/>
                <ComboBox x:Name="MovementTo" Grid.Row="1" Grid.Column="3" IsEditable="True" Margin="0,0,10,0"/>
                <Button Grid.Row="1" Grid.Column="4" Content="Переместить" Width="110" Height="26" FontWeight="Bold" Background="#FFF3CD" Click="OnMovement"/>
            </Grid>

            <Separator Margin="0,0,0,10"/>

            <!-- ================= ИСТОРИЯ ================= -->
            <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                <TextBlock Text="📜 Последние операции" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="🔄 Обновить" Width="90" Height="26" Click="OnRefreshClick"/>
            </StackPanel>

            <DataGrid x:Name="HistoryGrid" Height="220" AutoGenerateColumns="False" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="140"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>
    </ScrollViewer>
</UserControl>