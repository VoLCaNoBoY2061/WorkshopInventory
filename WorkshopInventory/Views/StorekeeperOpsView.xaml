<UserControl x:Class="WorkshopInventory.Views.StorekeeperOpsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="Учёт поступлений" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="ReceiptMaterial" Width="170" DisplayMemberPath="Name"/>
                <TextBox x:Name="ReceiptQty" Width="60" ToolTip="Количество"/>
                <TextBox x:Name="ReceiptSupplier" Width="130" ToolTip="Поставщик"/>
                <ComboBox x:Name="ReceiptLocation" Width="160" IsEditable="True" ToolTip="Склад назначения (можно ввести новый)"/>
                <Button Content="Оприходовать" Click="OnReceipt"/>
            </StackPanel>

            <Separator Margin="0,10"/>

            <TextBlock Text="Списание" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="WriteOffMaterial" Width="170" DisplayMemberPath="Name"/>
                <TextBox x:Name="WriteOffQty" Width="60" ToolTip="Количество"/>
                <TextBox x:Name="WriteOffReason" Width="130" ToolTip="Причина"/>
                <ComboBox x:Name="WriteOffLocation" Width="160" IsEditable="True" ToolTip="Склад, с которого списываем"/>
                <Button Content="Списать" Click="OnWriteOff"/>
            </StackPanel>

            <Separator Margin="0,10"/>

            <TextBlock Text="Перемещение между складами" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="MovementMaterial" Width="150" DisplayMemberPath="Name"/>
                <TextBox x:Name="MovementQty" Width="55" ToolTip="Количество"/>
                <ComboBox x:Name="MovementFrom" Width="150" ToolTip="Откуда"/>
                <ComboBox x:Name="MovementTo" Width="150" IsEditable="True" ToolTip="Куда (можно ввести название нового склада)"/>
                <Button Content="Переместить" Click="OnMovement"/>
            </StackPanel>

            <Separator Margin="0,10"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Последние операции" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <Button Content="Обновить" Click="OnRefreshClick"/>
            </StackPanel>
            <DataGrid x:Name="HistoryGrid" Height="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="140"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                    <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="80"/>
                    <DataGridTextColumn Header="Детали" Binding="{Binding Details}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
