<UserControl x:Class="WorkshopInventory.Views.RequestsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="15">

        <!-- ================= ПАНЕЛЬ СОЗДАНИЯ ЗАЯВКИ ================= -->
        <StackPanel x:Name="CreatePanel" DockPanel.Dock="Top" Visibility="Collapsed">
            <TextBlock Text="📝 Новая заявка" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" Foreground="#2C3E50"/>
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Материал" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Кол-во" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Тип заявки" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="Комментарий (необязательно)" FontSize="12" Foreground="DimGray" Margin="0,0,0,4"/>

                <ComboBox x:Name="MaterialCombo" Grid.Row="1" Grid.Column="0" DisplayMemberPath="Name" Margin="0,0,5,0"/>
                <TextBox x:Name="QtyBox" Grid.Row="1" Grid.Column="1" Margin="0,0,5,0" PreviewTextInput="NumberValidationTextBox"/>
                <ComboBox x:Name="TypeCombo" Grid.Row="1" Grid.Column="2" Margin="0,0,5,0"/>
                <TextBox x:Name="CommentBox" Grid.Row="1" Grid.Column="3" Margin="0,0,10,0"/>
                <Button Grid.Row="1" Grid.Column="4" Content="Создать заявку" Width="130" Height="26" FontWeight="Bold" Background="#D4EDDA" Click="OnCreateRequest"/>
            </Grid>
        </StackPanel>

        <!-- ================= КНОПКИ ДЕЙСТВИЙ НАД ТАБЛИЦЕЙ ================= -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ApproveButton" Content="✅ Одобрить" Width="110" Height="28" Margin="0,0,5,0" Background="#D4EDDA" Click="OnApprove" Visibility="Collapsed"/>
            <Button x:Name="RejectButton" Content="❌ Отклонить" Width="110" Height="28" Margin="0,0,5,0" Background="#F8D7DA" Click="OnReject" Visibility="Collapsed"/>
            <Button x:Name="FulfillButton" Content="📦 Выдать / принять возврат" Width="160" Height="28" Margin="0,0,5,0" Background="#FFF3CD" FontWeight="Bold" Click="OnFulfill" Visibility="Collapsed"/>
            <Button Content="🔄 Обновить" Width="90" Height="28" Click="OnRefresh"/>
        </StackPanel>

        <!-- ================= ТАБЛИЦА ЗАЯВОК ================= -->
        <DataGrid x:Name="Grid" SelectionMode="Single" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
            <!-- ДОБАВЛЕНА ПОДСВЕТКА ОТКЛОНЁННЫХ ЗАЯВОК -->
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRejected}" Value="True">
                            <Setter Property="Background" Value="#FFE0E0"/>
                            <Setter Property="Foreground" Value="#C00000"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="ToolTip" Value="Заявка отклонена. См. комментарий."/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Мастер" Binding="{Binding MasterName}" Width="120"/>
                <DataGridTextColumn Header="Материал" Binding="{Binding MaterialName}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Создана" Binding="{Binding DateCreated}" Width="130"/>
                <DataGridTextColumn Header="Комментарий" Binding="{Binding Comment}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</UserControl>