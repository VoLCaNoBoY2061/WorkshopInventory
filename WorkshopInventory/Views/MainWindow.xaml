<Window x:Class="WorkshopInventory.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkshopInventory.Views"
        Title="Учёт компонентов и материалов в мастерской" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#2F3E4E" Padding="12">
            <TextBlock x:Name="HeaderText" Foreground="White" FontSize="14"/>
        </Border>
        <TabControl x:Name="MainTabs" Margin="4">
            <TabItem Header="Материалы">
                <views:MaterialsView x:Name="MaterialsTab"/>
            </TabItem>
            <TabItem x:Name="StorekeeperTab" Header="Складские операции">
                <views:StorekeeperOpsView x:Name="StorekeeperOpsTab"/>
            </TabItem>
            <TabItem Header="Заявки">
                <views:RequestsView x:Name="RequestsTab"/>
            </TabItem>
            <TabItem x:Name="ReportsTabItem" Header="Отчёты">
                <views:ReportsView x:Name="ReportsTab"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
